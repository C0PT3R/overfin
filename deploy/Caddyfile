# The site, with Overfin's API, and the sign-in. Caddy gets the HTTPS
# certificates by itself: both names must point to this machine, with ports
# 80 and 443 open.

{$OVERFIN_DOMAIN} {
	handle /api/* {
		reverse_proxy overfin:8080
	}
	# The site's pages are private too: Overfin's gate sends visitors who
	# aren't logged in to the login, and back.
	handle {
		forward_auth overfin:8080 {
			uri /api/v1/gate
		}
		root * /srv/site
		file_server
	}
}

{$AUTH_DOMAIN} {
	reverse_proxy authentik-server:9000
}
