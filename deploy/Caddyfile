# The site and the sign-in. Caddy gets the HTTPS certificates by itself:
# both names must point to this machine, with ports 80 and 443 open.

# Overfin serves the API and the site (overfin-web, or your own client), to
# logged-in visitors only, with its own security headers.
{$OVERFIN_DOMAIN} {
	reverse_proxy overfin:8080
}

{$AUTH_DOMAIN} {
	reverse_proxy pocket-id:1411
}
